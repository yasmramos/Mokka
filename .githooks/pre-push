#!/bin/sh
# pre-push hook: warn when pushing directly to protected branches.
while read local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "pre-push: pushing to $(basename "$remote_ref") requires an explicit confirmation." >&2
            ;;
    esac
done
exit 0
