#!/usr/bin/env bash
# commit-msg hook: enforce Conventional Commits format for every commit.
#
# Expected first line:
#   <type>(<optional scope>)[!]: <description>
# Allowed types are listed below. The description must not be empty and the
# subject line should not end with a period.

set -euo pipefail

MSG_FILE="$1"
SUBJECT="$(head -n 1 "$MSG_FILE")"

# Allow merge/revert commits generated by Git itself.
case "$SUBJECT" in
  Merge\ *|Revert\ *) exit 0 ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9._-]+\))?!?:[[:space:]]?.+'

if ! [[ "$SUBJECT" =~ $PATTERN ]]; then
  cat >&2 <<EOF
ERROR: Commit message does not follow the Conventional Commits format.

  Received: $SUBJECT

  Expected: <type>(<scope>): <description>
  Types   : feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert

  Examples:
    feat(auth): add JWT token refresh endpoint
    fix(ui): prevent duplicate submit on form click
    docs(readme): document develop branch workflow
EOF
  exit 1
fi

if [[ "$SUBJECT" == *. ]]; then
  echo "ERROR: Commit subject must not end with a period." >&2
  exit 1
fi

exit 0
